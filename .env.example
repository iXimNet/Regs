# Rename this file to .env and fill in the values below.

# --- API Configuration ---
# The base URL of your OpenAI-compatible local LLM server.
# Example for LM Studio: "http://localhost:1234/v1"
API_BASE_URL="http://localhost:1234/v1"

# The API key for your LLM service. For many local services, this can be left as "not-needed".
API_KEY="not-needed"


# --- Model Configuration ---
# The model name to use for chat completions (the main audit task).
# Example for a local model file: "lmstudio-community/Meta-Llama-3-8B-Instruct-GGUF"
LLM_MODEL_NAME="default-model"

# The model name to use for generating text embeddings.
# Important: This should be a model specifically trained for embedding tasks.
# Example for a local model file: "nomic-ai/nomic-embed-text-v1.5-GGUF"
EMBEDDING_MODEL_NAME="default-embedding-model"
