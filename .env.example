# Rename this file to .env and fill in the values below.
# This file now supports separate configurations for the LLM and Embedding services.

# --- Large Language Model (LLM) Configuration ---
# Used for generating the audit report analysis and summaries.
LLM_API_BASE_URL="http://localhost:1234/v1"
LLM_API_KEY="not-needed"
LLM_MODEL_NAME="lmstudio-community/Meta-Llama-3-8B-Instruct-GGUF"

# --- Embedding Model Configuration ---
# Used for converting text documents into vector embeddings for the knowledge base.
# This can be a different server/provider from the LLM.
# If using the same server as the LLM, these values can be the same as above.
EMBEDDING_API_BASE_URL="http://localhost:1234/v1"
EMBEDDING_API_KEY="not-needed"
EMBEDDING_MODEL_NAME="nomic-ai/nomic-embed-text-v1.5-GGUF"
